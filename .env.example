# Copy to .env. Never commit .env.
# Core forecasting, allocation, routing, simulation and dispatch need NO keys and run offline.

# Optional chatbot (blank = deterministic template replies)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Offline kill-switch: set to 1 to force fully local mode (no network calls)
DENGUEWATCH_OFFLINE=0

# Optional weather context (Open-Meteo, no key)
WEATHER_TTL_S=10800
WEATHER_RETRY_S=300
WEATHER_TIMEOUT_S=4

# Chat limits
CHAT_MAX_TOKENS=300
CHAT_TIMEOUT_S=20
CHAT_CACHE_TTL_S=300
CHAT_RATE_PER_MIN=10

CORS_ORIGINS=*
